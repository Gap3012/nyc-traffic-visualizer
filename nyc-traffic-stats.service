[Unit]
Description=NYC Traffic Stats Service
After=network-online.target nyc-traffic-poller.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nyc-traffic-visualizer
ExecStart=/usr/bin/python3 /home/ubuntu/nyc-traffic-visualizer/stats.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
