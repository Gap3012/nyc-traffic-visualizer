[Unit]
Description=NYC Traffic Poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nyc-traffic-visualizer
ExecStart=/usr/bin/python3 /home/ubuntu/nyc-traffic-visualizer/poller.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
